{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "instructions": [
    "~/.opencode/AGENTS.md",
    "~/.opencode/skills/caveman/SKILL.md",
    "~/.opencode/skills/compact-context/SKILL.md"
  ],
  "mcp": {
    "mcp_everything": {
      "command": [
        "npx",
        "-y",
        "@angular/cli",
        "mcp"
      ],
      "type": "local"
    }
  },
  "model": "github-copilot/gpt-5.3-codex",
  "permission": "allow",
  "plugin": [
    "@slkiser/opencode-quota",
    "oh-my-openagent",
    "@tarquinen/opencode-dcp@latest"
  ],
  "snapshot": true
}
